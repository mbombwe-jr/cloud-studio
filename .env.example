# ================= Zoostudios Backend — Environment =================
# Copy to .env and adjust. NEVER commit real secrets.

# --- Runtime ---
NODE_ENV=development
PORT=3000
TZ=Africa/Dar_es_Salaam
PUBLIC_BASE_URL=http://localhost:3000

# --- Database ---
ZOO_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/zoostudios?schema=public

# --- Auth / Security ---
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=8h
API_KEY_PREFIX=zs
BCRYPT_ROUNDS=12
CORS_ORIGINS=*

# --- Rate limiting ---
THROTTLE_TTL=60000
THROTTLE_LIMIT=120

# --- iii engine (https://iii.dev) ---
# Local driver (default): Postgres-backed queue + in-process cron + persisted traces/analytics.
# Engine driver: set III_ENABLED=true and point III_URL at a running iii engine (ws://host:port).
III_ENABLED=false
III_URL=ws://127.0.0.1:49134

# --- Queue worker ---
QUEUE_POLL_INTERVAL_MS=1000
QUEUE_CONCURRENCY=5
QUEUE_MAX_ATTEMPTS=5

# --- ClickPesa (https://docs.clickpesa.com) ---
CLICKPESA_BASE_URL=https://api.clickpesa.com
CLICKPESA_CLIENT_ID=your-client-id
CLICKPESA_API_KEY=your-api-key
# Checksum secret used for HMAC-SHA256 canonical-JSON checksums (see docs.clickpesa.com/home/checksum)
CLICKPESA_CHECKSUM_KEY=your-checksum-key
CLICKPESA_CHECKSUM_ENABLED=true
# Payout create endpoints accept 1 request per merchant per 60s (provider limit)
CLICKPESA_PAYOUT_MIN_INTERVAL_MS=61000

# --- Beem Africa SMS (https://docs.beem.africa) ---
BEEM_SMS_BASE_URL=https://apisms.beem.africa
BEEM_API_KEY=your-beem-api-key
BEEM_SECRET_KEY=your-beem-secret-key
# Default shared sender name used when an account has no dedicated sender
SMS_DEFAULT_SENDER=ZOOINFO
SMS_RATE_TZS=20

# --- Provider mocking (set true ONLY for local dev/tests) ---
MOCK_PROVIDERS=false

# --- Seeding ---
SEED_ADMIN_EMAIL=admin@zoostudios.internal
SEED_ADMIN_PASSWORD=ChangeMe!2025
SEED_ADMIN_NAME=Platform Admin
